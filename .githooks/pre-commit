#!/bin/sh
# Pre-commit checks. Enable with: git config core.hooksPath .githooks
# The same checks run in CI (.github/workflows/guard.yml).
set -e
root="$(git rev-parse --show-toplevel)"

# Retail-data guard on the staged files.
python3 "$root/scripts/check_no_retail.py"

# Relative links in staged Markdown files.
md=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
if [ -n "$md" ]; then
  # shellcheck disable=SC2086
  python3 "$root/scripts/check_links.py" $md
fi

# YAML lint on staged YAML files, if yamllint is installed (CI always runs it).
yml=$(git diff --cached --name-only --diff-filter=ACMR -- '*.yml' '*.yaml')
if [ -n "$yml" ]; then
  if python3 -m yamllint --version >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    python3 -m yamllint -s $yml
  else
    echo "pre-commit: yamllint not installed; skipping YAML lint (CI will run it)." >&2
  fi
fi
